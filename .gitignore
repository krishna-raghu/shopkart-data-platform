.terraform/
**/.terraform/

*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files
*.tfvars
*.tfvars.json

# Keep Terraform dependency lock files
!.terraform.lock.hcl
**/.terraform.lock.hcl

# Environment / secrets
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
"@ | Set-Content .gitignore
# Local executable tools
tools/*.exe
